# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=            # Gemini, for the villagers (optional: falls back to Claude Haiku)
GEMINI_MODEL=gemini-2.5-flash
VILLAGER_MODEL=            # e.g. gemini or claude-haiku-5-5 (default: gemini if GOOGLE_API_KEY set)
EVALUATOR_MODEL=claude-sonnet-5-5
MONGODB_URI=               # MongoDB Atlas (optional: falls back to JSON files in runs/)
