# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=           # Gemini, for the villagers (optional: falls back to Claude Haiku)
GEMINI_MODEL=gemini-3.5-flash
VILLAGER_MODEL=            # e.g. gemini or claude-haiku-5-5 (default: gemini if GOOGLE_API_KEY set)
EVALUATOR_MODEL=claude-sonnet-5-5
MONGODB_URI=               # MongoDB Atlas: customer memory + vector search + every simulation (optional: falls back to JSON files in runs/)
MONGODB_DB=hackpton

# sponsors
PHOTON_API_KEY=            # iMessage agent (photon/), Photon 2.0 beta: photon.codes/beta
PHOTON_PROJECT_ID=
PHOTON_AGENT_HANDLE=       # the shared iMessage number assigned in the Photon dashboard
PUBLIC_URL=                # where texted "watch them shop" links point (default http://localhost:4621)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
NOVA_MODEL_ID=             # Amazon Nova on Bedrock, copy the model or inference-profile id from the Bedrock console
LLAMA_BEDROCK_MODEL_ID=    # Meta Llama on Bedrock, same

# LangSmith tracing (every agent, subagent and tool call shows up as a trace)
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent-ready
LANGSMITH_API_KEY=

# Agent evals (evals/, run with: .venv/bin/python -m pytest evals -v)
EVAL_JUDGE_MODEL=claude-opus-5-5   # the LLM-as-judge (should be stronger than the agents it grades)
EVAL_CUSTOMER_MODELS=Claude        # comma-separated model families to run the customer evals on, e.g. Claude,Gemini,GPT
